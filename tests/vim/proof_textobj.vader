" A constructor named Abort matches the end pattern before the proof.
Given coq (constructor-named-abort-i):
  Inductive op := Commit | Abort.
  Goal True.
  Proof.
    auto.
  Qed.

Do (constructor-named-abort-i):
  diP

Expect coq (constructor-named-abort-i):
  Inductive op := Commit | Abort.
  Goal True.
  Proof.
  Qed.

" Nested proofs. The end is found with searchpairpos, but the start is
" found with a plain backward search, which stops at the inner Proof.
Given coq (nested-outer-i):
  Lemma outer : True.
  Proof.
    Lemma inner : True.
    Proof.
      auto.
    Qed.
    auto.
  Qed.

Do (nested-outer-i):
  7GdiP

Expect coq (nested-outer-i):
  Lemma outer : True.
  Proof.
  Qed.

Given coq (cursor-mid-qed-i):
  Goal True.
  Proof.
    auto.
  Qed.

Do (cursor-mid-qed-i):
  4GldiP

Expect coq (cursor-mid-qed-i):
  Goal True.
  Proof.
  Qed.

