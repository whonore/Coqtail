" Once the cursor is moved to the start of Proof., searchpairpos('c')
" counts that Proof. as a nested start, so the pairing is shifted by one: it
" returns the first UNMATCHED terminator after the proof. Here that is the Qed of
" a lemma that has no Proof., so the range swallows the next lemma.
Given coq (proof-kw-before-proofless-qed-i):
  Lemma a : True.
  Proof.
    auto.
  Qed.
  Lemma b : True.
    auto.
  Qed.

Do (proof-kw-before-proofless-qed-i):
  2GldiP

Expect coq (proof-kw-before-proofless-qed-i):
  Lemma a : True.
  Proof.
  Qed.
  Lemma b : True.
    auto.
  Qed.

" Same mechanism, with a constructor named Abort after the proof.
Given coq (constructor-named-abort-after-i):
  Goal True.
  Proof.
    auto.
  Qed.
  Inductive op := Commit | Abort.

Do (constructor-named-abort-after-i):
  2GldiP

Expect coq (constructor-named-abort-after-i):
  Goal True.
  Proof.
  Qed.
  Inductive op := Commit | Abort.

